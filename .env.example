# ============================================================================
# Orbit | Vietnam — Environment Variables Template (.env.example)
# Sao chép tệp này thành `.env` khi chạy local và cấu hình trên Vercel Dashboard
# TUYỆT ĐỐI KHÔNG commit tệp `.env` chứa token thật lên Git!
# ============================================================================

# 1. Turso Cloud Database (libSQL)
TURSO_DATABASE_URL=https://daiviet-daiviet.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# 2. Discord Bot & Server Configuration
DISCORD_TOKEN=your_discord_bot_token_here
GUILD_ID=1532265330079174697
DATABASE_ARCHIVE_CHANNEL_ID=1548627763467128912

# 3. Local Bot Bridge & HMAC RPC Queue Signing
BOT_API_URL=http://localhost:8080
BOT_API_SECRET=replace_with_strong_random_secret_min_16_chars
BOT_RPC_SECRET=replace_with_strong_hmac_sha256_secret_for_rpc_queue
WEB_HOST=0.0.0.0
WEB_PORT=5000

# 4. Cloud AI Engine (Tùy chọn cho Deep Verify & Gia Sư AI)
NVIDIA_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
